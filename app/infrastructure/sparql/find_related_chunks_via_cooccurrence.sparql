{{PREFIXES}}

SELECT DISTINCT ?relatedSection ?relatedChunk ?relatedText ?relatedIndex ?bridgeConcept WHERE {
    {{seed_section_uri}} ki4kmu:hasConcept ?seedConcept .

    ?seedConcept ki4kmu:coOccursWith ?bridgeConcept .

    ?relatedSection ki4kmu:hasConcept ?bridgeConcept ;
                    rdf:type ki4kmu:Section .
    FILTER(?relatedSection != {{seed_section_uri}})

    ?relatedSection ki4kmu:isContained ?relatedChunk .
    ?relatedChunk rdf:type ki4kmu:Chunk ;
                  ki4kmu:text ?relatedText ;
                  ki4kmu:chunk_index ?relatedIndex .
}
ORDER BY ?relatedIndex
