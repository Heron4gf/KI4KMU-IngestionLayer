{{PREFIXES}}

SELECT DISTINCT ?relatedSection ?relatedChunk ?relatedText ?relatedIndex ?bridgeTag WHERE {
    {{seed_section_uri}} ki4kmu:hasTag ?seedTag .

    ?seedTag ki4kmu:coOccursWith ?bridgeTag .

    ?relatedSection ki4kmu:hasTag ?bridgeTag ;
                    rdf:type ki4kmu:Section .
    FILTER(?relatedSection != {{seed_section_uri}})

    ?relatedSection ki4kmu:isContained ?relatedChunk .
    ?relatedChunk rdf:type ki4kmu:Chunk ;
                  ki4kmu:text ?relatedText ;
                  ki4kmu:chunk_index ?relatedIndex .
}
ORDER BY ?relatedIndex
