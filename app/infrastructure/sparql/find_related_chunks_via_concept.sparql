{{PREFIXES}}

SELECT DISTINCT ?relatedSection ?relatedChunk ?relatedText ?relatedIndex ?sharedConcept WHERE {
    {{seed_section_uri}} ki4kmu:hasConcept ?sharedConcept .

    ?relatedSection ki4kmu:hasConcept ?sharedConcept ;
                    rdf:type ki4kmu:Section .
    FILTER(?relatedSection != {{seed_section_uri}})

    ?relatedSection ki4kmu:isContained ?relatedChunk .
    ?relatedChunk rdf:type ki4kmu:Chunk ;
                  ki4kmu:text ?relatedText ;
                  ki4kmu:chunk_index ?relatedIndex .
}
ORDER BY ?sharedConcept ?relatedIndex
