# ── Langfuse Tracing ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb-ingestion
CHROMA_PORT=8000
CHROMA_COLLECTION=documents

# ── GraphDB ───────────────────────────────────────────────────────────────────
GRAPHDB_URL=http://graphdb-ingestion:7200
GRAPHDB_REPOSITORY=rag-repo
GRAPHDB_BASE_NS=http://ki4kmu.fhnw.ch/ontology#
GRAPHDB_VERSION=10.7.0
GRAPHDB_PORT=7200
GRAPHDB_USER=
GRAPHDB_PASSWORD=
GDB_JAVA_OPTS=-Xmx2g -Dgraphdb.home=/ki4kmu_data/graphdb

# ── Section Extractor ─────────────────────────────────────────────────────────
EXTRACTOR_BASE_URL=
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL_ID=
EXTRACTOR_PROMPT_PATH=/prompts/extract.md

# ── AI Captioning ─────────────────────────────────────────────────────────────
CAPTIONING_AI_BASE_URL=
CAPTIONING_AI_MODEL=
CAPTIONING_AI_API_KEY=
CAPTION_MAX_TOKENS=256
CAPTIONER_PROMPT_PATH=/prompts/captioner.md

# ── Embedding & Reranker models ───────────────────────────────────────────────
EMBEDDING_MODEL_PATH=/ki4kmu_data/embedding-model

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=

# ── OpenRouter (optional) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── GUI ───────────────────────────────────────────────────────────────────────
GUI_PORT=8501

# ── Evaluation container ──────────────────────────────────────────────────────
# Gemma 4 E2B server (OpenAI-compatible)
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-e2b

# Confident AI (deepeval)
CONFIDENT_AI_KEY=

# Dataset / run config
EVAL_DATASET_SPLIT=train
EVAL_LIMIT=200
EVAL_INGEST_BATCH_SIZE=50
EVAL_TOP_K=5
# Set to 2, 3, or 4 to skip earlier phases on restart
EVAL_START_PHASE=1
