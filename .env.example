# =============================================================================
# KI4KMU IngestionLayer - Environment Configuration Example
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# NOTE: Variables marked [REQUIRED] must be set for the application to function.
# All other variables have sensible defaults and are optional.
# =============================================================================


# =============================================================================
# [REQUIRED] AI Captioning Configuration
# =============================================================================
# The app supports two captioning modes:
#   1. LOCAL (default): Uses Florence-2 model downloaded from HuggingFace
#      → Set USE_LOCAL_CAPTIONER=true to enable (recommended for offline/private use)
#   2. REMOTE: Uses an OpenAI-compatible API (e.g., OpenRouter)
#      → Leave USE_LOCAL_CAPTIONER=false (or unset) and set the variables below
#
# If using LOCAL captioner (recommended), the REMOTE variables below are NOT needed.

USE_LOCAL_CAPTIONER=true
# CAPTIONER_MODEL_PATH=/ki4kmu_data/captioner-model       # Local model storage path
# FLORENCE2_MODEL_ID=microsoft/Florence-2-base            # HuggingFace model ID

# Remote captioning (only needed if USE_LOCAL_CAPTIONER=false)
# CAPTIONING_AI_BASE_URL=https://openrouter.ai/api/v1/
# CAPTIONING_AI_MODEL=google/gemma-4-26b-a4b-it:nitro
# CAPTIONING_AI_API_KEY=your-api-key
# CAPTION_MAX_TOKENS=256                                  # Max tokens for caption generation
# CAPTIONER_PROMPT_PATH=prompts/captioner.md              # Path to captioner system prompt


# =============================================================================
# [OPTIONAL] Observability / Tracing — Langfuse
# =============================================================================
# Set these to enable LLM call tracing and monitoring.
# The application runs fine without Langfuse (a warning is logged on startup).

# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com                # Defaults to Langfuse Cloud


# =============================================================================
# [OPTIONAL] Reranker Configuration
# =============================================================================
# The app supports two reranking modes:
#   1. LOCAL (default): Uses a cross-encoder reranker downloaded from HuggingFace
#   2. OPENROUTER: Uses Cohere rerank via OpenRouter API

USE_LOCAL_RERANKER=true
# RERANK_MODEL=cross-encoder/ettin-reranker-68m-v1       # HuggingFace model ID
# RERANKER_MODEL_PATH=/ki4kmu_data/reranker-model-weights # Local model storage path

# OpenRouter reranker (only needed if USE_LOCAL_RERANKER=false)
# OPENROUTER_API_KEY=your-openrouter-api-key              # Also required for section extractor
# OPENROUTER_RERANK_MODEL=cohere/rerank-4-fast


# =============================================================================
# [OPTIONAL] Text Embedding Model Configuration
# =============================================================================
# The embedding model is downloaded from HuggingFace at first use.

# TEXT_MODEL=perplexity-ai/pplx-embed-v1-0.6b             # HuggingFace model ID
# EMBEDDING_MODEL_PATH=/ki4kmu_data/embedding-model       # Local model storage path
# HF_TOKEN=your-huggingface-token                         # Optional: speeds up gated model downloads


# =============================================================================
# [OPTIONAL] GraphDB Configuration
# =============================================================================
# Defaults point to a Docker service named 'graphdb-ingestion'.
# Adjust if running GraphDB on a different host/port or with a different repository.

# GRAPHDB_URL=http://graphdb-ingestion:7200
# GRAPHDB_REPOSITORY=rag-repo
# GRAPHDB_BASE_NS=http://ki4kmu.fhnw.ch/ontology#
# GRAPHDB_USER=                                           # Leave empty if no authentication
# GRAPHDB_PASSWORD=
# GRAPHDB_VERSION=10.7.0                                  # Used by docker-compose
# GDB_JAVA_OPTS=-Xmx2g -Dgraphdb.home=/ki4kmu_data/graphdb  # JVM options for GraphDB


# =============================================================================
# [OPTIONAL] ChromaDB Configuration
# =============================================================================
# Defaults point to a Docker service named 'chromadb-ingestion'.

# CHROMA_HOST=chromadb-ingestion
# CHROMA_PORT=8000
# CHROMA_COLLECTION=documents


# =============================================================================
# [OPTIONAL] Preprocessing Service Configuration
# =============================================================================
# The app expects a preprocessing service (e.g., NLP-Extractors) at this URL.

# PREPROCESSING_URL=http://preprocessing:8000/general/v0/general
# PREPROCESSING_CHUNKING_STRATEGY=by_title                # Options: by_title, none, etc.
# PREPROCESSING_MAX_CHARACTERS=512
# PREPROCESSING_OVERLAP=30
# PREPROCESSING_READ_TIMEOUT=120.0
# PREPROCESSING_SPLIT_PAGE_SIZE=10
# PREPROCESSING_SPLIT_CONCURRENCY=3


# =============================================================================
# [REQUIRED] Section Extractor Service Configuration
# =============================================================================
# The section-extractor is a SEPARATE microservice (see section_extractor/).
# It is required for full document ingestion with section extraction.
# You MUST set these API keys and run the section-extractor service.

SECTION_EXTRACTOR_URL=http://section-extractor:8003   # URL the main app uses to reach this service
EXTRACTOR_BASE_URL=https://openrouter.ai/api/v1/
EXTRACTOR_API_KEY=your-openrouter-api-key
EXTRACTOR_MODEL_ID=google/gemma-4-26b-a4b-it:exacto
EXTRACTOR_PROMPT_PATH=/prompts/extract.md


# =============================================================================
# [OPTIONAL] GUI Configuration
# =============================================================================
# Used by the Streamlit-based GUI (see gui/streamlit_app.py).

# GUI_PORT=8501
