# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ChromaDB Configuration
CHROMA_HOST=chromadb-ingestion
CHROMA_PORT=8000
CHROMA_COLLECTION=documents

# Unstructured API Configuration
UNSTRUCTURED_URL=http://unstructured:8000/general/v0/general
UNSTRUCTURED_CHUNKING_STRATEGY=by_title
UNSTRUCTURED_MAX_CHARACTERS=1000
UNSTRUCTURED_OVERLAP=150
UNSTRUCTURED_READ_TIMEOUT = 120.0
UNSTRUCTURED_SPLIT_PAGE_SIZE = 10
UNSTRUCTURED_SPLIT_CONCURRENCY = 3

# Captioning AI Configuration
CAPTIONING_AI_BASE_URL=http://localhost:1234/v1
CAPTIONING_AI_MODEL=your-model-name
CAPTIONING_AI_API_KEY=your-api-key

# Caption Configuration
CAPTION_MAX_TOKENS=256
CAPTIONER_PROMPT_PATH=/prompts/captioner.md

# GraphDB
GRAPHDB_VERSION=10.7.0
GRAPHDB_PORT=7200
GDB_JAVA_OPTS=-Dgraphdb.workbench.importDirectory=/opt/graphdb/home/import

# GraphDB Writer
GRAPHDB_URL=http://graphdb-ingestion:7200
GRAPHDB_REPOSITORY=pdf-ingestion
GRAPHDB_BASE_NS=http://ki4kmu.fhnw.ch/ontology#

# Optional
GRAPHDB_USER=
GRAPHDB_PASSWORD=

# GUI Service
GUI_PORT=8501

# Section Extractor Service
SECTION_EXTRACTOR_PORT=8003
SECTION_EXTRACTOR_URL=http://section-extractor:8003
LANGEXTRACT_BASE_URL=http://host.docker.internal:1234/v1
LANGEXTRACT_API_KEY=lm-studio
LANGEXTRACT_MODEL_ID=openai/gpt-4o
LANGEXTRACT_PROMPT_PATH=/prompts/section_extract.md

# Optional, makes the model download faster
HF_TOKEN=