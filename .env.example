# =============================================================================
# REQUIRED VARIABLES - Must be set for the application to work
# =============================================================================

# -----------------------------------------------------------------------------
# Langfuse Configuration (Observability/Tracing)
# Required: Your Langfuse project credentials from https://cloud.langfuse.com
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# AI Captioning Configuration
# Required: API endpoint and credentials for image captioning AI
# -----------------------------------------------------------------------------
CAPTIONING_AI_BASE_URL=https://openrouter.ai/api/v1/
CAPTIONING_AI_MODEL=google/gemma-4-26b-a4b-it:nitro
CAPTIONING_AI_API_KEY=your-api-key

# -----------------------------------------------------------------------------
# OpenRouter API Key (for reranking via API)
# Required: Get yours at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key

# -----------------------------------------------------------------------------
# HuggingFace Token
# Optional but speeds up model downloads
# Get yours at https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
# HF_TOKEN=your-huggingface-token

# -----------------------------------------------------------------------------
# Section Extractor AI Configuration
# Required: API endpoint and credentials for section extraction AI
# -----------------------------------------------------------------------------
EXTRACTOR_BASE_URL=https://openrouter.ai/api/v1/
EXTRACTOR_API_KEY=your-api-key
EXTRACTOR_MODEL_ID=google/gemma-4-26b-a4b-it:exacto

# =============================================================================
# OPTIONAL VARIABLES - Have sensible defaults, customize as needed
# =============================================================================

# ChromaDB Configuration (default: chromadb-ingestion:8000, collection: documents)
# CHROMA_HOST=chromadb-ingestion
# CHROMA_PORT=8000
# CHROMA_COLLECTION=documents

# GraphDB Configuration
# GRAPHDB_VERSION=10.7.0
# GRAPHDB_PORT=7200
# GRAPHDB_URL=http://graphdb-ingestion:7200
# GRAPHDB_REPOSITORY=rag-repo
# GRAPHDB_BASE_NS=http://ki4kmu.fhnw.ch/ontology#
# GDB_JAVA_OPTS=-Xmx2g -Dgraphdb.home=/ki4kmu_data/graphdb

# GraphDB Credentials (leave empty if no auth required)
# GRAPHDB_USER=
# GRAPHDB_PASSWORD=

# Caption Configuration
# CAPTION_MAX_TOKENS=256
# CAPTIONER_PROMPT_PATH=/prompts/captioner.md

# Embedding Model Configuration
# EMBEDDING_MODEL_PATH=/ki4kmu_data/embedding-model

# Reranker Model Configuration (for query-time reranking via OpenRouter API)
# RERANK_MODEL=qwen/qwen3-embedding-8b

# GUI Configuration
# GUI_PORT=8501
